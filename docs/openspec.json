{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskPulse API & Services OpenSpec",
    "description": "Especificación formal OpenSpec / OpenAPI 3.1 para la arquitectura de TaskPulse con esquema de datos 100% en español ('tareas'), autenticación, políticas RLS y endpoints/servicios.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://your-project.supabase.co",
      "description": "Supabase Cloud API Gateway (Producción)"
    },
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor Local Next.js"
    }
  ],
  "paths": {
    "/auth/v1/signup": {
      "post": {
        "summary": "Registro de nuevo usuario",
        "tags": ["Autenticación"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredencialesAutenticacion"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario registrado exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaAutenticacion"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/token?grant_type=password": {
      "post": {
        "summary": "Inicio de sesión (Login)",
        "tags": ["Autenticación"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredencialesAutenticacion"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaAutenticacion"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/tareas": {
      "get": {
        "summary": "Listar tareas del usuario",
        "tags": ["Tareas"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de tareas recuperadas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tarea"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear una nueva tarea",
        "tags": ["Tareas"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearTareaEntrada"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tarea creada satisfactoriamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tarea"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Tarea": {
        "type": "object",
        "required": ["id", "usuario_id", "titulo", "completada", "prioridad", "creado_en", "actualizado_en"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "usuario_id": { "type": "string", "format": "uuid" },
          "titulo": { "type": "string" },
          "descripcion": { "type": "string", "nullable": true },
          "prioridad": { "type": "string", "enum": ["baja", "media", "alta"] },
          "completada": { "type": "boolean" },
          "creado_en": { "type": "string", "format": "date-time" },
          "actualizado_en": { "type": "string", "format": "date-time" }
        }
      },
      "CrearTareaEntrada": {
        "type": "object",
        "required": ["titulo"],
        "properties": {
          "titulo": { "type": "string" },
          "descripcion": { "type": "string" },
          "prioridad": { "type": "string", "enum": ["baja", "media", "alta"], "default": "media" }
        }
      },
      "CredencialesAutenticacion": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "RespuestaAutenticacion": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string" },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "email": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
